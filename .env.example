# =============================================================================
# Explainable SOC Assistant - Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and update with local environment values.
# DO NOT commit real API keys or sensitive secrets to version control.

# Generative AI / LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
MOCK_LLM=false

# Model Artifact Paths
CLASSIFIER_MODEL_PATH=models/classifier.joblib
EXPLAINER_MODEL_PATH=models/shap_explainer.joblib
FEATURE_ENCODER_PATH=models/feature_encoder.joblib

# Pipeline & Streamer Settings
STREAM_LOG_FILE=data/raw/network_logs.csv
STREAM_INTERVAL_SECONDS=1.0
STREAM_WINDOW_SIZE=100
LOG_LEVEL=INFO

# State Store & Database
STATE_DATABASE_URL=sqlite:///artifacts/pipeline_state.db

# Analyst Dashboard Configuration
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8501
